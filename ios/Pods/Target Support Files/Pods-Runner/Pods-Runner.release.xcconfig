ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES = YES
CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER = NO
FRAMEWORK_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/Ably" "${PODS_CONFIGURATION_BUILD_DIR}/AblyDeltaCodec" "${PODS_CONFIGURATION_BUILD_DIR}/ably_flutter" "${PODS_CONFIGURATION_BUILD_DIR}/msgpack"
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) COCOAPODS=1 HAVE_DELTA_CONFIG_H=1
HEADER_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/Ably/Ably.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/AblyDeltaCodec/AblyDeltaCodec.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/ably_flutter/ably_flutter.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/msgpack/msgpack.framework/Headers"
LD_RUNPATH_SEARCH_PATHS = $(inherited) /usr/lib/swift '@executable_path/Frameworks' '@loader_path/Frameworks'
LIBRARY_SEARCH_PATHS = $(inherited) "${TOOLCHAIN_DIR}/usr/lib/swift/${PLATFORM_NAME}" /usr/lib/swift
OTHER_LDFLAGS = $(inherited) -framework "Ably" -framework "AblyDeltaCodec" -framework "ably_flutter" -framework "msgpack"
OTHER_MODULE_VERIFIER_FLAGS = $(inherited) "-F${PODS_CONFIGURATION_BUILD_DIR}/Ably" "-F${PODS_CONFIGURATION_BUILD_DIR}/AblyDeltaCodec" "-F${PODS_CONFIGURATION_BUILD_DIR}/Flutter" "-F${PODS_CONFIGURATION_BUILD_DIR}/ably_flutter" "-F${PODS_CONFIGURATION_BUILD_DIR}/msgpack"
OTHER_SWIFT_FLAGS = $(inherited) -D COCOAPODS
PODS_BUILD_DIR = ${BUILD_DIR}
PODS_CONFIGURATION_BUILD_DIR = ${PODS_BUILD_DIR}/$(CONFIGURATION)$(EFFECTIVE_PLATFORM_NAME)
PODS_PODFILE_DIR_PATH = ${SRCROOT}/.
PODS_ROOT = ${SRCROOT}/Pods
PODS_XCFRAMEWORKS_BUILD_DIR = $(PODS_CONFIGURATION_BUILD_DIR)/XCFrameworkIntermediates
USE_RECURSIVE_SCRIPT_INPUTS_IN_SCRIPT_PHASES = YES
