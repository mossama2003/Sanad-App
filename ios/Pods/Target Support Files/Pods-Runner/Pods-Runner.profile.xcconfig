ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES = YES
CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER = NO
FRAMEWORK_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/Ably" "${PODS_CONFIGURATION_BUILD_DIR}/AblyDeltaCodec" "${PODS_CONFIGURATION_BUILD_DIR}/Mantle" "${PODS_CONFIGURATION_BUILD_DIR}/SDWebImage" "${PODS_CONFIGURATION_BUILD_DIR}/SDWebImageWebPCoder" "${PODS_CONFIGURATION_BUILD_DIR}/ably_flutter" "${PODS_CONFIGURATION_BUILD_DIR}/flutter_image_compress_common" "${PODS_CONFIGURATION_BUILD_DIR}/image_gallery_saver_plus" "${PODS_CONFIGURATION_BUILD_DIR}/libwebp" "${PODS_CONFIGURATION_BUILD_DIR}/msgpack" "${PODS_CONFIGURATION_BUILD_DIR}/open_file_ios" "${PODS_CONFIGURATION_BUILD_DIR}/permission_handler_apple"
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) COCOAPODS=1 HAVE_DELTA_CONFIG_H=1 $(inherited) SD_WEBP=1
HEADER_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/Ably/Ably.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/AblyDeltaCodec/AblyDeltaCodec.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/Mantle/Mantle.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/SDWebImage/SDWebImage.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/SDWebImageWebPCoder/SDWebImageWebPCoder.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/ably_flutter/ably_flutter.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/flutter_image_compress_common/flutter_image_compress_common.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/image_gallery_saver_plus/image_gallery_saver_plus.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/libwebp/libwebp.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/msgpack/msgpack.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/open_file_ios/open_file_ios.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/permission_handler_apple/permission_handler_apple.framework/Headers"
LD_RUNPATH_SEARCH_PATHS = $(inherited) /usr/lib/swift '@executable_path/Frameworks' '@loader_path/Frameworks'
LIBRARY_SEARCH_PATHS = $(inherited) "${TOOLCHAIN_DIR}/usr/lib/swift/${PLATFORM_NAME}" /usr/lib/swift
OTHER_LDFLAGS = $(inherited) -ObjC -framework "Ably" -framework "AblyDeltaCodec" -framework "CoreGraphics" -framework "Foundation" -framework "ImageIO" -framework "Mantle" -framework "SDWebImage" -framework "SDWebImageWebPCoder" -framework "ably_flutter" -framework "flutter_image_compress_common" -framework "image_gallery_saver_plus" -framework "libwebp" -framework "msgpack" -framework "open_file_ios" -framework "permission_handler_apple"
OTHER_MODULE_VERIFIER_FLAGS = $(inherited) "-F${PODS_CONFIGURATION_BUILD_DIR}/Ably" "-F${PODS_CONFIGURATION_BUILD_DIR}/AblyDeltaCodec" "-F${PODS_CONFIGURATION_BUILD_DIR}/Flutter" "-F${PODS_CONFIGURATION_BUILD_DIR}/Mantle" "-F${PODS_CONFIGURATION_BUILD_DIR}/SDWebImage" "-F${PODS_CONFIGURATION_BUILD_DIR}/SDWebImageWebPCoder" "-F${PODS_CONFIGURATION_BUILD_DIR}/ably_flutter" "-F${PODS_CONFIGURATION_BUILD_DIR}/flutter_image_compress_common" "-F${PODS_CONFIGURATION_BUILD_DIR}/image_gallery_saver_plus" "-F${PODS_CONFIGURATION_BUILD_DIR}/libwebp" "-F${PODS_CONFIGURATION_BUILD_DIR}/msgpack" "-F${PODS_CONFIGURATION_BUILD_DIR}/open_file_ios" "-F${PODS_CONFIGURATION_BUILD_DIR}/permission_handler_apple"
OTHER_SWIFT_FLAGS = $(inherited) -D COCOAPODS
PODS_BUILD_DIR = ${BUILD_DIR}
PODS_CONFIGURATION_BUILD_DIR = ${PODS_BUILD_DIR}/$(CONFIGURATION)$(EFFECTIVE_PLATFORM_NAME)
PODS_PODFILE_DIR_PATH = ${SRCROOT}/.
PODS_ROOT = ${SRCROOT}/Pods
PODS_XCFRAMEWORKS_BUILD_DIR = $(PODS_CONFIGURATION_BUILD_DIR)/XCFrameworkIntermediates
USE_RECURSIVE_SCRIPT_INPUTS_IN_SCRIPT_PHASES = YES
